{
    "private": true,
    "description": "Bab in web assembly",
    "type": "module",
    "files": [
        "pkg/*"
    ],
    "directories": {
        "example": "example"
    },
    "scripts": {
        "start": "vite",
        "build": "./build-wasm.sh",
        "build-example": "./build-wasm.sh && mkdir -p ./public && rm -rf ./public/* && vite --mode staging --base=\"/bab-rs\" build",
        "toc": "markdown-toc --maxdepth 3 -i README.md",
        "version": "npm run toc",
        "postversion": "git push --follow-tags && npm publish"
    },
    "exports": {
        ".": "./pkg/bab.js"
    },
    "devDependencies": {
        "@preact/preset-vite": "^2.10.2",
        "@substrate-system/css-normalize": "^0.0.13",
        "@substrate-system/debug": "^0.9.32",
        "@substrate-system/human-bytes": "^0.0.4",
        "browserslist": "^4.27.0",
        "esbuild": "^0.27.0",
        "htm": "^3.1.1",
        "lightningcss": "^1.30.2",
        "markdown-toc": "^1.2.0",
        "preact": "^10.27.2",
        "typescript": "^5.9.3",
        "vite": "^7.1.12"
    },
    "keywords": [
        "bab",
        "hash",
        "blake3"
    ],
    "bugs": {
        "url": "https://github.com/substrate-system/bab-rs/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/substrate-system/bab-rs.git"
    },
    "dependencies": {
        "@preact/signals": "^2.4.0"
    }
}
